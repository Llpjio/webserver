# Port for HTTP & WebSocket server
PORT=3000

# Environment mode (development / production)
NODE_ENV=development

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@world1.nezymvi.mongodb.net/e4all?retryWrites=true&w=majority&appName=world1
MONGODB_URI=mongodb+srv://<username>:<password>@world1.nezymvi.mongodb.net/e4all?retryWrites=true&w=majority&appName=world1

# JWT Secret for user authentication tokens
JWT_SECRET=super-secret-e4all-token-key-change-this

# Cloudflare R2 (S3-compatible Object Storage) for Minecraft World Saves
# Leave empty to fall back to local disk storage in ./uploads/
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=e4all-worlds
# Optional public domain or worker for public direct downloads:
# R2_PUBLIC_DOMAIN=https://pub-xxxxxx.r2.dev
